# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP del servidor
PORT=3000

# Fuente de datos: memory (datos de prueba en memoria) | mysql (base de datos real)
DATA_SOURCE=memory

# Orígenes permitidos para CORS, separados por coma. Usa * solo en desarrollo.
# Ejemplo: CORS_ORIGINS=http://localhost:5173,https://devorap.netlify.app
CORS_ORIGINS=*

# Registrar cada solicitud en la consola (true | false)
LOG_REQUESTS=true

# Conexión a MySQL (solo si DATA_SOURCE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=devora
DB_PASSWORD=
DB_NAME=devora
DB_CONNECTION_LIMIT=10

# Carpetas estáticas opcionales para servir todo desde un solo servidor.
# Rutas relativas a la carpeta backend. Déjalas vacías si no se usan.
FRONTEND_DIR=../frontend
PANEL_DIR=../panel
