{
  "name": "devora-backend",
  "version": "1.0.0",
  "description": "API REST de DEVORA: mesas, menú, comensales y pedidos individuales en mesas grupales.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node scripts/supervisor.js",
