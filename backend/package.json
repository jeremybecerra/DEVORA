    "test:mysql": "node --test --test-reporter=spec tests/repositorios.contrato.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.11.5"
  },
  "license": "UNLICENSED",
